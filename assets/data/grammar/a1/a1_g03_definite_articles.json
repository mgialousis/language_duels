{
  "id": "a1_g03_definite_articles",
  "category": "articles",
  "subcategory": "definite",
  "level": "A1",
  "order": 3,
  "title": {
    "en": "Definite Articles (ο/η/το)",
    "el": "Οριστικά Άρθρα (ο/η/το)",
    "ca": "Articles Definits (ο/η/το)"
  },
  "description": {
    "en": "Learn how Greek definite articles change by gender",
    "el": "Μάθε πώς αλλάζουν τα οριστικά άρθρα ανά γένος",
    "ca": "Aprèn com canvien els articles definits segons el gènere"
  },
  "explanation": {
    "content": {
      "en": "Greek nouns have grammatical gender. The definite article changes to match the noun.",
      "el": "Τα ουσιαστικά στα ελληνικά έχουν γένος. Το άρθρο αλλάζει για να ταιριάζει.",
      "ca": "Els substantius grecs tenen gènere. L'article canvia per concordar."
    },
    "rules": [
      {
        "en": "Masculine: ο (singular), οι (plural)",
        "el": "Αρσενικό: ο (ενικός), οι (πληθυντικός)",
        "ca": "Masculí: ο (singular), οι (plural)"
      },
      {
        "en": "Feminine: η (singular), οι (plural)",
        "el": "Θηλυκό: η (ενικός), οι (πληθυντικός)",
        "ca": "Femení: η (singular), οι (plural)"
      },
      {
        "en": "Neuter: το (singular), τα (plural)",
        "el": "Ουδέτερο: το (ενικός), τα (πληθυντικός)",
        "ca": "Neutre: το (singular), τα (plural)"
      }
    ]
  },
  "tables": [
    {
