  "level": "A1",
  "order": 5,
  "title": {
    "en": "Subject Pronouns",
    "el": "Προσωπικές Αντωνυμίες",
    "ca": "Pronoms Personals"
  },
  "description": {
    "en": "Learn the basic subject pronouns in Greek",
    "el": "Μάθε τις βασικές προσωπικές αντωνυμίες στα ελληνικά",
    "ca": "Aprèn els pronoms personals bàsics en grec"
  },
  "explanation": {
    "content": {
      "en": "Subject pronouns are often optional in Greek, but it is useful to recognize and use them.",
      "el": "Οι προσωπικές αντωνυμίες συχνά παραλείπονται στα ελληνικά, αλλά είναι χρήσιμο να τις γνωρίζεις.",
      "ca": "Els pronoms personals sovint s'ometen en grec, però és útil conèixer-los."
    },
    "rules": [
      {
        "en": "Singular: εγώ (I), εσύ (you), αυτός/αυτή/αυτό (he/she/it)",
        "el": "Ενικός: εγώ, εσύ, αυτός/αυτή/αυτό",
        "ca": "Singular: εγώ, εσύ, αυτός/αυτή/αυτό"
      },
      {
        "en": "Plural: εμείς (we), εσείς (you), αυτοί/αυτές/αυτά (they)",
        "el": "Πληθυντικός: εμείς, εσείς, αυτοί/αυτές/αυτά",
        "ca": "Plural: εμείς, εσείς, αυτοί/αυτές/αυτά"
      }
    ]
  },
  "tables": [
