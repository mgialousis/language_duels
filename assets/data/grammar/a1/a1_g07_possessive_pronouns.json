  "title": {
    "en": "Possessive Pronouns",
    "el": "Κτητικές Αντωνυμίες",
    "ca": "Pronoms Possessius"
  },
  "description": {
    "en": "Use short possessive pronouns after nouns in Greek.",
    "el": "Χρήση των σύντομων κτητικών αντωνυμιών μετά από ουσιαστικά.",
    "ca": "Usa els pronoms possessius curts després del nom."
  },
  "explanation": {
    "content": {
      "en": "In Greek, short possessive pronouns usually come after the noun and do not change for gender or number.",
      "el": "Στα ελληνικά, οι σύντομες κτητικές αντωνυμίες μπαίνουν συνήθως μετά το ουσιαστικό και δεν αλλάζουν σε γένος ή αριθμό.",
      "ca": "En grec, els pronoms possessius curts solen anar després del nom i no canvien pel gènere o el nombre."
    },
    "rules": [
      {
        "en": "Singular: μου (my), σου (your), του/της/του (his/her/its)",
        "el": "Ενικός: μου, σου, του/της/του",
        "ca": "Singular: μου, σου, του/της/του"
      },
      {
        "en": "Plural: μας (our), σας (your), τους (their)",
        "el": "Πληθυντικός: μας, σας, τους",
        "ca": "Plural: μας, σας, τους"
      },
      {
        "en": "Placement: το βιβλίο μου (my book), οι φίλοι τους (their friends)",
        "el": "Θέση: το βιβλίο μου, οι φίλοι τους",
        "ca": "Posicio: το βιβλίο μου, οι φίλοι τους"
      }
    ]
  },
  "tables": [
    {
      "title": {
