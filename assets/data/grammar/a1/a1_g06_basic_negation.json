  "level": "A1",
  "order": 6,
  "title": {
    "en": "Basic Negation (δεν)",
    "el": "Άρνηση (δεν)",
    "ca": "Negació Bàsica (δεν)"
  },
  "description": {
    "en": "Use δεν to make simple negative sentences",
    "el": "Χρησιμοποίησε το δεν για απλές αρνητικές προτάσεις",
    "ca": "Fes frases negatives amb δεν"
  },
  "explanation": {
    "content": {
      "en": "To negate a sentence, place δεν before the verb.",
      "el": "Για άρνηση, βάλε το δεν πριν από το ρήμα.",
      "ca": "Per negar una frase, posa δεν abans del verb."
    },
    "rules": [
      {
        "en": "δεν + verb",
        "el": "δεν + ρήμα",
        "ca": "δεν + verb"
      },
      {
        "en": "The verb usually stays the same form.",
        "el": "Το ρήμα μένει στην ίδια μορφή.",
        "ca": "El verb normalment no canvia."
      }
    ]
  },
  "examples": [
    {
      "id": "ex_601",
      "greek": "Δεν είμαι εδώ.",
      "romanization": "ðen ˈime eðˈo.",
      "catalan": "No soc aqui.",
      "englishLiteral": "I am not here.",
      "highlights": [
        {
          "startIndex": 0,
          "endIndex": 3,
          "explanation": "Negation marker"
        }
      ]
    },
    {
      "id": "ex_602",
