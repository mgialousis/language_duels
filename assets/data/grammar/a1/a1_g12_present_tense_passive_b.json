  "title": {
    "en": "Present Tense - B2 Class (Passive Voice)",
    "el": "Ενεστώτας - Β2 Τάξη (Παθητική Φωνή)",
    "ca": "Present - Classe B2 (Veu Passiva)"
  },
  "description": {
    "en": "Learn B2 class passive present endings like -ούμαι, -είσαι, -είται. B2 verbs have accented -ώ with 'ει' in active voice.",
    "el": "Μάθε τις καταλήξεις της Β2 τάξης στην παθητική φωνή: -ούμαι, -είσαι, -είται. Τα Β2 ρήματα έχουν τονισμένο -ώ με 'ει' στην ενεργητική φωνή.",
    "ca": "Aprèn les terminacions de la classe B2 en veu passiva: -ούμαι, -είσαι, -είται. Els verbs B2 tenen -ώ accentuat amb 'ει' en veu activa."
  },
  "explanation": {
    "content": {
      "en": "B2 class passive verbs (from θεωρώ, μπορώ) take endings: -ούμαι, -είσαι, -είται, -ούμαστε, -είστε, -ούνται (e.g., θεωρούμαι).",
      "el": "Τα ρήματα της Β2 τάξης στην παθητική φωνή (από θεωρώ, μπορώ) παίρνουν καταλήξεις: -ούμαι, -είσαι, -είται, -ούμαστε, -είστε, -ούνται (π.χ. θεωρούμαι).",
      "ca": "Els verbs de classe B2 en veu passiva (de θεωρώ, μπορώ) prenen terminacions: -ούμαι, -είσαι, -είται, -ούμαστε, -είστε, -ούνται (p. ex. θεωρούμαι)."
    },
    "rules": [
      {
        "en": "B2 passive verbs come from B2 active verbs (θεωρώ → θεωρούμαι, μπορώ → can't be passivized).",
        "el": "Τα Β2 παθητικά ρήματα προέρχονται από Β2 ενεργητικά (θεωρώ → θεωρούμαι, μπορώ → δεν μπορεί να γίνει παθητικό).",
        "ca": "Els verbs B2 passius provenen de verbs B2 actius (θεωρώ → θεωρούμαι, μπορώ → no pot ser passivitzat)."
      },
      {
        "en": "Endings: -ούμαι, -είσαι, -είται, -ούμαστε, -είστε, -ούνται. Note the 'ει' in 2nd/3rd person.",
        "el": "Καταλήξεις: -ούμαι, -είσαι, -είται, -ούμαστε, -είστε, -ούνται. Παρατήρησε το 'ει' στα β'/γ' πρόσωπα.",
        "ca": "Terminacions: -ούμαι, -είσαι, -είται, -ούμαστε, -είστε, -ούνται. Nota el 'ει' a 2a/3a persona."
      }
    ]
  },
