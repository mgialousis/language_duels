  "id": "a1_g08_present_tense_regular",
  "category": "verb_conjugation",
  "subcategory": "present_tense",
  "level": "A1",
  "order": 8,
  "title": {
    "en": "Present Tense - A Class (Active Voice)",
    "el": "Ενεστώτας - Α Τάξη (Ενεργητική Φωνή)",
    "ca": "Present - Classe A (Veu Activa)"
  },
  "description": {
    "en": "Master A class verbs - the largest verb group representing 75% of all Greek verbs. These verbs have unaccented -ω.",
    "el": "Κατακτήστε τα ρήματα της Α τάξης - η μεγαλύτερη ομάδα ρημάτων που αποτελεί το 75% όλων των ελληνικών ρημάτων. Αυτά τα ρήματα έχουν μη τονισμένο -ω.",
    "ca": "Domina els verbs de classe A - el grup de verbs més gran que representa el 75% de tots els verbs grecs. Aquests verbs tenen -ω sense accent."
  },
  "explanation": {
    "content": {
      "en": "A class verbs are the most common in Greek (75% of all verbs). They end in unaccented -ω and follow the pattern: γράφω, γράφεις, γράφει, γράφουμε, γράφετε, γράφουν(ε). Recognition: NO accent on the final -ω.",
      "el": "Τα ρήματα της Α τάξης είναι τα πιο συνηθισμένα στα ελληνικά (75% όλων των ρημάτων). Τελειώνουν σε μη τονισμένο -ω και ακολουθούν το μοτίβο: γράφω, γράφεις, γράφει, γράφουμε, γράφετε, γράφουν(ε). Αναγνώριση: ΧΩΡΙΣ τόνο στο τελικό -ω.",
      "ca": "Els verbs de classe A són els més comuns en grec (75% de tots els verbs). Acaben en -ω sense accent i segueixen el patró: γράφω, γράφεις, γράφει, γράφουμε, γράφετε, γράφουν(ε). Reconeixement: SENSE accent a la -ω final."
    },
    "rules": [
      {
        "en": "How to recognize A class: The final -ω has NO accent mark (γράφω, βλέπω, ακούω).",
        "el": "Πώς αναγνωρίζουμε την Α τάξη: Το τελικό -ω ΔΕΝ έχει τόνο (γράφω, βλέπω, ακούω).",
        "ca": "Com reconèixer la classe A: La -ω final NO té accent (γράφω, βλέπω, ακούω)."
      },
      {
        "en": "A class endings: -ω, -εις, -ει, -ουμε/-ομε, -ετε, -ουν(ε).",
        "el": "Καταλήξεις Α τάξης: -ω, -εις, -ει, -ουμε/-ομε, -ετε, -ουν(ε).",
        "ca": "Terminacions classe A: -ω, -εις, -ει, -ουμε/-ομε, -ετε, -ουν(ε)."
      },
      {
        "en": "This is the default conjugation pattern - most new Greek verbs follow this class.",
        "el": "Αυτό είναι το προεπιλεγμένο μοτίβο κλίσης - τα περισσότερα νέα ελληνικά ρήματα ακολουθούν αυτή την τάξη.",
        "ca": "Aquest és el patró de conjugació predeterminat - la majoria dels nous verbs grecs segueixen aquesta classe."
      }
    ],
    "tips": [
      {
        "en": "Common A class verbs: γράφω (write), διαβάζω (read), ακούω (hear), μαθαίνω (learn), ανοίγω (open), κλείνω (close).",
        "el": "Συχνά ρήματα Α τάξης: γράφω (γράφω), διαβάζω (διαβάζω), ακούω (ακούω), μαθαίνω (μαθαίνω), ανοίγω (ανοίγω), κλείνω (κλείνω).",
        "ca": "Verbs comuns de classe A: γράφω (escriure), διαβάζω (llegir), ακούω (escoltar), μαθαίνω (aprendre), ανοίγω (obrir), κλείνω (tancar)."
      }
    ]
  },
