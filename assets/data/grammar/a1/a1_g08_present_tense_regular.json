  "explanation": {
    "content": {
      "en": "Regular -ω verbs take standard present endings: -ω, -εις, -ει, -ουμε, -ετε, -ουν(ε).",
      "el": "Τα κανονικά ρήματα σε -ω παίρνουν τις καταλήξεις: -ω, -εις, -ει, -ουμε, -ετε, -ουν(ε).",
      "ca": "Els verbs regulars en -ω prenen les terminacions: -ω, -εις, -ει, -ουμε, -ετε, -ουν(ε)."
    },
    "rules": [
      {
        "en": "μιλάω: μιλάω, μιλάς, μιλά, μιλάμε, μιλάτε, μιλάνε",
        "el": "μιλάω: μιλάω, μιλάς, μιλά, μιλάμε, μιλάτε, μιλάνε",
        "ca": "μιλάω: μιλάω, μιλάς, μιλά, μιλάμε, μιλάτε, μιλάνε"
      }
    ]
  },
