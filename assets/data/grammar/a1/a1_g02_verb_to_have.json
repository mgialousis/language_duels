  "order": 2,
  "title": {
    "en": "The Verb \"To Have\" (Έχω)",
    "el": "Το Ρήμα «Έχω»",
    "ca": "El Verb \"Tenir\" (Έχω)"
  },
  "description": {
    "en": "Learn to conjugate the verb έχω and talk about possession",
    "el": "Μάθε να κλίνεις το ρήμα έχω για κατοχή",
    "ca": "Aprèn a conjugar el verb έχω per parlar de possessió"
  },
  "explanation": {
    "content": {
      "en": "The verb **έχω** (to have) is used to talk about possession, family, and objects you own.",
      "el": "Το ρήμα **έχω** χρησιμοποιείται για να μιλάμε για κατοχή, οικογένεια και αντικείμενα.",
      "ca": "El verb **έχω** s'utilitza per parlar de possessió, família i objectes."
    },
    "rules": [
      {
        "en": "Use έχω for 1st person singular (I have).",
        "el": "Χρησιμοποίησε έχω για το 1ο ενικό.",
        "ca": "Utilitza έχω per a la 1a persona singular."
      },
      {
        "en": "Plural forms end in -ουμε, -ετε, -ουν.",
        "el": "Οι πληθυντικοί τύποι τελειώνουν σε -ουμε, -ετε, -ουν.",
        "ca": "Els plurals acaben en -ουμε, -ετε, -ουν."
      }
    ],
    "tips": [
      {
        "en": "Try simple phrases: Έχω ένα βιβλίο.",
        "el": "Δοκίμασε απλές φράσεις: Έχω ένα βιβλίο.",
        "ca": "Prova frases simples: Έχω ένα βιβλίο."
      }
    ]
  },
