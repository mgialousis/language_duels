{
  "id": "a1_g04_indefinite_articles",
  "category": "articles",
  "subcategory": "indefinite",
  "level": "A1",
  "order": 4,
  "title": {
    "en": "Indefinite Articles (ένας/μία/ένα)",
    "el": "Αόριστα Άρθρα (ένας/μία/ένα)",
    "ca": "Articles Indefinits (ένας/μία/ένα)"
  },
  "description": {
    "en": "Use indefinite articles to talk about one of something",
    "el": "Χρησιμοποίησε αόριστα άρθρα για κάτι αόριστο",
    "ca": "Fes servir articles indefinits per parlar d'alguna cosa"
  },
  "explanation": {
    "content": {
      "en": "Indefinite articles correspond to 'a/an'. They agree with the noun's gender.",
      "el": "Τα αόριστα άρθρα αντιστοιχούν στο 'ένας/μία/ένα' και συμφωνούν με το γένος.",
      "ca": "Els articles indefinits equivalen a 'un/una' i concorden amb el gènere."
    },
    "rules": [
      {
        "en": "Masculine: ένας",
        "el": "Αρσενικό: ένας",
        "ca": "Masculí: ένας"
      },
      {
        "en": "Feminine: μία",
        "el": "Θηλυκό: μία",
        "ca": "Femení: μία"
      },
      {
        "en": "Neuter: ένα",
        "el": "Ουδέτερο: ένα",
        "ca": "Neutre: ένα"
      }
    ]
  },
  "tables": [
    {
