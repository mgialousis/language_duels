{
  "id": "a1_g10_present_tense_irregular",
  "category": "verb_conjugation",
  "subcategory": "present_tense",
  "level": "A1",
  "order": 10,
  "title": {
    "en": "Present Tense - Common Irregular Verbs",
    "el": "Ενεστώτας - Συχνά Ανώμαλα Ρήματα",
    "ca": "Present - Verbs Irregulars Comuns"
  },
  "description": {
    "en": "Practice high-frequency irregular verbs and important A class verbs (unaccented -ω) in the present tense.",
    "el": "Εξάσκηση σε συχνά ανώμαλα ρήματα και σημαντικά ρήματα της A τάξης (μη τονισμένα -ω) στον ενεστώτα.",
    "ca": "Practica verbs irregulars freqüents i verbs importants de classe A (-ω sense accent) en present."
  },
  "explanation": {
    "content": {
      "en": "This lesson covers truly irregular verbs (πάω, τρώω, λέω, έρχομαι, γίνομαι) and important A class verbs (βλέπω, παίρνω, πίνω, έχω). A class verbs have unaccented -ω and follow the pattern: -ω, -εις, -ει, -ουμε, -ετε, -ουν(ε). They represent 75% of all Greek verbs.",
      "el": "Αυτό το μάθημα καλύπτει πραγματικά ανώμαλα ρήματα (πάω, τρώω, λέω, έρχομαι, γίνομαι) και σημαντικά ρήματα της A τάξης (βλέπω, παίρνω, πίνω, έχω). Τα ρήματα της A τάξης έχουν μη τονισμένο -ω και ακολουθούν το μοτίβο: -ω, -εις, -ει, -ουμε, -ετε, -ουν(ε). Αποτελούν το 75% όλων των ελληνικών ρημάτων.",
      "ca": "Aquesta lliçó cobreix verbs veritablement irregulars (πάω, τρώω, λέω, έρχομαι, γίνομαι) i verbs importants de classe A (βλέπω, παίρνω, πίνω, έχω). Els verbs de classe A tenen -ω sense accent i segueixen el patró: -ω, -εις, -ει, -ουμε, -ετε, -ουν(ε). Representen el 75% de tots els verbs grecs."
    },
    "rules": [
      {
        "en": "Irregular verbs (πάω, τρώω, λέω, έρχομαι, γίνομαι): Must be memorized - they don't follow standard patterns.",
        "el": "Ανώμαλα ρήματα (πάω, τρώω, λέω, έρχομαι, γίνομαι): Πρέπει να τα απομνημονεύσεις - δεν ακολουθούν τυπικά μοτίβα.",
        "ca": "Verbs irregulars (πάω, τρώω, λέω, έρχομαι, γίνομαι): Cal memoritzar-los - no segueixen patrons estàndard."
      },
      {
        "en": "A class verbs (βλέπω, παίρνω, πίνω, έχω): Regular verbs with unaccented -ω. Pattern: -ω, -εις, -ει, -ουμε, -ετε, -ουν(ε).",
        "el": "Ρήματα A τάξης (βλέπω, παίρνω, πίνω, έχω): Κανονικά ρήματα με μη τονισμένο -ω. Μοτίβο: -ω, -εις, -ει, -ουμε, -ετε, -ουν(ε).",
        "ca": "Verbs de classe A (βλέπω, παίρνω, πίνω, έχω): Verbs regulars amb -ω sense accent. Patró: -ω, -εις, -ει, -ουμε, -ετε, -ουν(ε)."
      }
    ]
  },
