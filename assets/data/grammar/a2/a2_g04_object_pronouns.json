{
  "id": "a2_g04_object_pronouns",
  "category": "pronouns",
  "subcategory": "object",
  "level": "A2",
  "order": 4,
  "title": {
    "en": "Object Pronouns (Αντικειμενικές Αντωνυμίες)",
    "el": "Αντικειμενικές Αντωνυμίες",
    "ca": "Pronoms Objecte (Αντικειμενικές Αντωνυμίες)"
  },
  "description": {
    "en": "Use weak object pronouns for direct and indirect objects.",
    "el": "Χρήση αδύνατων αντικειμενικών αντωνυμιών.",
    "ca": "Usa pronoms febles per a objectes directes i indirectes."
  },
  "explanation": {
    "content": {
      "en": "Greek has weak (clitic) object pronouns that come before the verb. They can be accusative (direct object) or genitive (indirect object). The pronouns are: με, σε, τον/την/το, μας, σας, τους/τις/τα.",
      "el": "Τα ελληνικά έχουν αδύνατες αντικειμενικές αντωνυμίες που μπαίνουν πριν από το ρήμα. Μπορεί να είναι σε αιτιατική (άμεσο αντικείμενο) ή γενική (έμμεσο αντικείμενο).",
      "ca": "El grec té pronoms febles que van abans del verb. Poden ser acusatiu (objecte directe) o genitiu (objecte indirecte)."
    },
    "rules": [
      {
        "en": "Accusative (direct): με (me), σε (you), τον/την/το (him/her/it), μας (us), σας (you), τους/τις/τα (them)",
        "el": "Αιτιατική: με, σε, τον/την/το, μας, σας, τους/τις/τα",
        "ca": "Acusatiu: με, σε, τον/την/το, μας, σας, τους/τις/τα"
      },
      {
        "en": "Genitive (indirect): μου (to me), σου (to you), του/της/του (to him/her/it), μας (to us), σας (to you), τους (to them)",
        "el": "Γενική: μου, σου, του/της/του, μας, σας, τους",
        "ca": "Genitiu: μου, σου, του/της/του, μας, σας, τους"
      },
      {
        "en": "Order: Genitive before Accusative (Μου το δίνει = He gives it to me)",
        "el": "Σειρά: Γενική πριν από Αιτιατική (Μου το δίνει)",
        "ca": "Ordre: Genitiu abans d'Acusatiu (Μου το δίνει)"
      }
    ]
  },
