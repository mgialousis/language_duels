{
  "id": "a2_g03_future_simple",
  "category": "verb_conjugation",
  "subcategory": "future_tense",
  "level": "A2",
  "order": 3,
  "title": {
    "en": "Simple Future (Μέλλοντας Στιγμιαίος)",
    "el": "Μέλλοντας Στιγμιαίος",
    "ca": "Futur Simple (Μέλλοντας Στιγμιαίος)"
  },
  "description": {
    "en": "Express future actions using θα + verb.",
    "el": "Έκφραση μελλοντικών πράξεων με θα + ρήμα.",
    "ca": "Expressa accions futures amb θα + verb."
  },
  "explanation": {
    "content": {
      "en": "The simple future in Greek uses the particle θα followed by the perfective (aorist) stem. This expresses a completed action in the future. θα + aorist stem: θα γράψω (I will write).",
      "el": "Ο μέλλοντας στιγμιαίος χρησιμοποιεί το θα + αοριστικό θέμα. Εκφράζει ολοκληρωμένη πράξη στο μέλλον. θα + θέμα αορίστου: θα γράψω.",
      "ca": "El futur simple en grec utilitza la partícula θα + tema de l'aorist. Expressa una acció completada en el futur."
    },
    "rules": [
      {
        "en": "θα + aorist stem + present endings",
        "el": "θα + θέμα αορίστου + καταλήξεις ενεστώτα",
        "ca": "θα + tema aorist + terminacions present"
      },
      {
        "en": "γράφω → θα γράψω (I will write)",
        "el": "γράφω → θα γράψω",
        "ca": "γράφω → θα γράψω"
      },
      {
        "en": "μιλάω → θα μιλήσω (I will speak)",
        "el": "μιλάω → θα μιλήσω",
        "ca": "μιλάω → θα μιλήσω"
      }
    ]
  },
  "tables": [
    {
