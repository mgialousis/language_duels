{
  "id": "a2_g05_comparatives",
  "category": "adjectives",
  "subcategory": "comparison",
  "level": "A2",
  "order": 5,
  "title": {
    "en": "Comparatives (Συγκριτικός Βαθμός)",
    "el": "Συγκριτικός Βαθμός",
    "ca": "Comparatius (Συγκριτικός Βαθμός)"
  },
  "description": {
    "en": "Compare people and things using comparative forms.",
    "el": "Σύγκριση προσώπων και πραγμάτων με τον συγκριτικό βαθμό.",
    "ca": "Compara persones i coses amb formes comparatives."
  },
  "explanation": {
    "content": {
      "en": "Greek comparatives can be formed in two ways: (1) πιο + adjective (more common in speech), or (2) adding -τερος/-τερη/-τερο to the stem. Use από for 'than'.",
      "el": "Ο συγκριτικός σχηματίζεται με δύο τρόπους: (1) πιο + επίθετο (πιο συνηθισμένο στον προφορικό), ή (2) προσθήκη -τερος/-τερη/-τερο. Χρησιμοποίησε από για τη σύγκριση.",
      "ca": "El comparatiu grec es forma de dues maneres: (1) πιο + adjectiu, o (2) afegint -τερος/-τερη/-τερο. Usa από per a 'que'."
    },
    "rules": [
      {
        "en": "πιο + adjective: πιο μεγάλος (bigger/older)",
        "el": "πιο + επίθετο: πιο μεγάλος",
        "ca": "πιο + adjectiu: πιο μεγάλος"
      },
      {
        "en": "Suffix form: μεγάλος → μεγαλύτερος",
        "el": "Με κατάληξη: μεγάλος → μεγαλύτερος",
        "ca": "Amb sufix: μεγάλος → μεγαλύτερος"
      },
      {
        "en": "Comparison: Είναι πιο ψηλός από μένα (He is taller than me)",
        "el": "Σύγκριση: Είναι πιο ψηλός από μένα",
        "ca": "Comparació: Είναι πιο ψηλός από μένα"
      }
    ]
  },
