{
  "id": "a2_g07_simple_past_irregular",
  "category": "verb_conjugation",
  "subcategory": "past_tense",
  "level": "A2",
  "order": 7,
  "title": {
    "en": "Simple Past (Αόριστος) - Irregular Verbs",
    "el": "Αόριστος - Ανώμαλα Ρήματα",
    "ca": "Passat Simple (Αόριστος) - Verbs Irregulars"
  },
  "description": {
    "en": "Learn the most common irregular Simple Past forms. These high-frequency verbs have unpredictable aorist stems that must be memorized.",
    "el": "Μάθετε τους πιο συνηθισμένους ανώμαλους τύπους Αορίστου. Αυτά τα ρήματα υψηλής συχνότητας έχουν απρόβλεπτα θέματα που πρέπει να απομνημονευθούν.",
    "ca": "Aprèn les formes de Passat Simple irregulars més comunes. Aquests verbs d'alta freqüència tenen temes imprevisibles que cal memoritzar."
  },
  "explanation": {
    "content": {
      "en": "Many of the most common Greek verbs are irregular in the Simple Past. Their aorist stems cannot be predicted from the present tense and must be learned individually. The endings remain regular (-α, -ες, -ε, -αμε, -ατε, -αν), but the stem changes dramatically.",
      "el": "Πολλά από τα πιο συνηθισμένα ελληνικά ρήματα είναι ανώμαλα στον Αόριστο. Τα θέματα του αορίστου τους δεν μπορούν να προβλεφθούν από τον ενεστώτα και πρέπει να μαθευτούν ξεχωριστά. Οι καταλήξεις παραμένουν κανονικές (-α, -ες, -ε, -αμε, -ατε, -αν), αλλά το θέμα αλλάζει δραματικά.",
      "ca": "Molts dels verbs grecs més comuns són irregulars en el Passat Simple. Els seus temes d'aorist no es poden predir del present i s'han d'aprendre individualment. Les terminacions segueixen sent regulars (-α, -ες, -ε, -αμε, -ατε, -αν), però el tema canvia dràsticament."
    },
    "rules": [
      {
        "en": "πάω (go) → πήγα: Stem changes completely. πήγα, πήγες, πήγε, πήγαμε, πήγατε, πήγαν.",
        "el": "πάω (πηγαίνω) → πήγα: Το θέμα αλλάζει εντελώς. πήγα, πήγες, πήγε, πήγαμε, πήγατε, πήγαν.",
        "ca": "πάω (anar) → πήγα: El tema canvia completament. πήγα, πήγες, πήγε, πήγαμε, πήγατε, πήγαν."
      },
      {
        "en": "τρώω (eat) → έφαγα: Completely different stem with augment. έφαγα, έφαγες, έφαγε, φάγαμε, φάγατε, έφαγαν.",
        "el": "τρώω (τρώγω) → έφαγα: Εντελώς διαφορετικό θέμα με αύξηση. έφαγα, έφαγες, έφαγε, φάγαμε, φάγατε, έφαγαν.",
        "ca": "τρώω (menjar) → έφαγα: Tema completament diferent amb augment."
      },
      {
        "en": "πίνω (drink) → ήπια: Stem changes and augment η-. ήπια, ήπιες, ήπιε, ήπιαμε, ήπιατε, ήπιαν.",
        "el": "πίνω (πίνω) → ήπια: Το θέμα αλλάζει και αύξηση η-. ήπια, ήπιες, ήπιε, ήπιαμε, ήπιατε, ήπιαν.",
        "ca": "πίνω (beure) → ήπια: El tema canvia i augment η-."
      },
      {
        "en": "βλέπω (see) → είδα: Completely different stem. είδα, είδες, είδε, είδαμε, είδατε, είδαν.",
        "el": "βλέπω (βλέπω) → είδα: Εντελώς διαφορετικό θέμα. είδα, είδες, είδε, είδαμε, είδατε, είδαν.",
        "ca": "βλέπω (veure) → είδα: Tema completament diferent."
      },
      {
        "en": "λέω (say) → είπα: Stem changes to ειπ-. είπα, είπες, είπε, είπαμε, είπατε, είπαν.",
        "el": "λέω (λέγω) → είπα: Το θέμα αλλάζει σε ειπ-. είπα, είπες, είπε, είπαμε, είπατε, είπαν.",
        "ca": "λέω (dir) → είπα: El tema canvia a ειπ-."
      },
      {
        "en": "έρχομαι (come) → ήρθα: Deponent verb with irregular aorist. ήρθα, ήρθες, ήρθε, ήρθαμε, ήρθατε, ήρθαν.",
        "el": "έρχομαι (έρχομαι) → ήρθα: Αποθετικό ρήμα με ανώμαλο αόριστο. ήρθα, ήρθες, ήρθε, ήρθαμε, ήρθατε, ήρθαν.",
        "ca": "έρχομαι (venir) → ήρθα: Verb deponent amb aorist irregular."
      },
      {
        "en": "βρίσκω (find) → βρήκα: Irregular stem βρηκ-. βρήκα, βρήκες, βρήκε, βρήκαμε, βρήκατε, βρήκαν.",
        "el": "βρίσκω (βρίσκω) → βρήκα: Ανώμαλο θέμα βρηκ-. βρήκα, βρήκες, βρήκε, βρήκαμε, βρήκατε, βρήκαν.",
        "ca": "βρίσκω (trobar) → βρήκα: Tema irregular βρηκ-."
      }
    ],
    "tips": [
      {
        "en": "Must memorize: πάω→πήγα, τρώω→έφαγα, πίνω→ήπια, βλέπω→είδα, λέω→είπα, έρχομαι→ήρθα, παίρνω→πήρα, φεύγω→έφυγα, βρίσκω→βρήκα, μπαίνω→μπήκα",
        "el": "Πρέπει να απομνημονεύσετε: πάω→πήγα, τρώω→έφαγα, πίνω→ήπια, βλέπω→είδα, λέω→είπα, έρχομαι→ήρθα, παίρνω→πήρα, φεύγω→έφυγα, βρίσκω→βρήκα, μπαίνω→μπήκα",
        "ca": "Cal memoritzar: πάω→πήγα, τρώω→έφαγα, πίνω→ήπια, βλέπω→είδα, λέω→είπα, έρχομαι→ήρθα, παίρνω→πήρα, φεύγω→έφυγα, βρίσκω→βρήκα, μπαίνω→μπήκα"
      },
      {
        "en": "These verbs are among the most frequently used in Greek. Learning their aorist forms is essential for basic communication.",
        "el": "Αυτά τα ρήματα είναι από τα πιο συχνά χρησιμοποιούμενα στα ελληνικά. Η εκμάθηση των τύπων αορίστου τους είναι απαραίτητη για βασική επικοινωνία.",
        "ca": "Aquests verbs són dels més freqüentment usats en grec. Aprendre les seves formes d'aorist és essencial per a la comunicació bàsica."
      }
    ]
  },
